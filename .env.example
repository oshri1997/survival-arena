# Server only. Generate two different values with: openssl rand -hex 24
TEAM_ADMIN_KEY=replace-with-a-long-private-admin-key
TEAM_EVENT_KEY=replace-with-a-different-private-connector-key
PORT=8787
TEAM_STATE_PATH=data/teams.sqlite
# true for interactive browser demos. Set both false for a connected broadcast.
TEAM_DEMO_JOIN=true
TEAM_SEED_DEMO=true

# Optional server-only Euler Stream JSON collector. Leave ALL three unset for mocks.
# Do not prefix these with VITE_. No TikTok password/cookie is requested.
# TIKTOK_USERNAME=your_username
# TIKTOK_CREATOR_ID=your_numeric_tiktok_user_id_as_a_string
# EULER_API_KEY=provider_api_key
