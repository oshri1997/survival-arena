{
  "name": "survival-arena-live",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "assets": "node scripts/generate-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "teams": "npm run build && tsx server/index.ts",
    "teams:server": "tsx server/index.ts",
    "build:demo": "npm run build && node scripts/prepare-team-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
